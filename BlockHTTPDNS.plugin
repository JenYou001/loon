# 通用 DoH / HTTPDNS 路径（HTTPS 需要 MITM 才能生效）
^https?:\/\/[^\/]+\/(?:resolve|d|dns-query|query|v\d+\/resolve|v\d+\/dns-query) reject
^https?:\/\/[^\/]+\/resolve\? reject
^https?:\/\/[^\/]+\/dns-query\? reject

# Alipay HTTPDNS：返回空 JSON（仅在需要时启用 MITM）
^https?:\/\/amdc\.alipay\.com\/query mock-response-body data-type=json data="{}" status-code=200
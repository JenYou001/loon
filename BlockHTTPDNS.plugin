[Rewrite]
# ═══════════════════════════════════════════════════════════
# HTTP 层兜底（503 = 服务不可用，App 会优雅降级到系统 DNS）
# 当 IP-CIDR 被主配置 GEOIP 抢占时，此层仍有效
# ═══════════════════════════════════════════════════════════

# 阿里 squery
request if ${url} ~= /^https?:\/\/110\.76\.8\.150\/squery/i then reject(503)
request if ${url} ~= /^https?:\/\/203\.209\.230\.39\/squery/i then reject(503)
request if ${url} ~= /^https?:\/\/203\.209\.245\.102\/squery/i then reject(503)
request if ${url} ~= /^https?:\/\/203\.209\.245\.158\/squery/i then reject(503)
request if ${url} ~= /^https?:\/\/203\.209\.247\.95\/squery/i then reject(503)
request if ${url} ~= /^https?:\/\/203\.209\.250\.41\/squery/i then reject(503)
request if ${url} ~= /^https?:\/\/203\.209\.250\.114\/squery/i then reject(503)
request if ${url} ~= /^https?:\/\/203\.209\.251\.147\/squery/i then reject(503)
request if ${url} ~= /^https?:\/\/\[2400:B180:6001::18F\]\/squery/i then reject(503)
request if ${url} ~= /^https?:\/\/\[2400:B200:1005:3000::155\]\/squery/i then reject(503)
request if ${url} ~= /^https?:\/\/\[2400:B200:1005:3000::1D3\]\/squery/i then reject(503)
request if ${url} ~= /^https?:\/\/\[2400:B200:5000:B000::C8\]\/squery/i then reject(503)

# 百度
request if ${url} ~= /^http:\/\/180\.76\.76\.112\/v4\/resolve/i then reject(503)
request if ${url} ~= /^http:\/\/180\.76\.76\.220\/v4\/resolve/i then reject(503)

# B站
request if ${url} ~= /^http:\/\/47\.101\.175\.206\/resolve/i then reject(503)
request if ${url} ~= /^http:\/\/47\.100\.123\.169\/resolve/i then reject(503)
request if ${url} ~= /^http:\/\/120\.46\.169\.234\/resolve/i then reject(503)
request if ${url} ~= /^http:\/\/121\.36\.72\.124\/resolve/i then reject(503)
request if ${url} ~= /^http:\/\/116\.63\.10\.135\/resolve/i then reject(503)
request if ${url} ~= /^http:\/\/116\.63\.10\.31\/resolve/i then reject(503)
request if ${url} ~= /^http:\/\/122\.9\.7\.134\/resolve/i then reject(503)
request if ${url} ~= /^http:\/\/122\.9\.13\.79\/resolve/i then reject(503)
request if ${url} ~= /^http:\/\/122\.9\.15\.129\/resolve/i then reject(503)
request if ${url} ~= /^http:\/\/117\.185\.228\.108\/resolve/i then reject(503)
request if ${url} ~= /^http:\/\/117\.144\.238\.29\/resolve/i then reject(503)
request if ${url} ~= /^http:\/\/101\.91\.140\.224\/resolve/i then reject(503)
request if ${url} ~= /^http:\/\/101\.91\.140\.124\/resolve/i then reject(503)
request if ${url} ~= /^http:\/\/114\.116\.215\.110\/resolve/i then reject(503)
request if ${url} ~= /^http:\/\/112\.64\.218\.119\/resolve/i then reject(503)
request if ${url} ~= /^http:\/\/112\.65\.200\.117\/resolve/i then reject(503)

# 字节跳动
request if ${url} ~= /^https?:\/\/.*\.zijieapi\.com\/get_domains\//i then reject(503)

# 京东
request if ${url} ~= /^https?:\/\/dns\.jd\.com\/v6\/b/i then reject(503)

# 美团
request if ${url} ~= /^http:\/\/103\.37\.155\.60\/fetch/i then reject(503)

# 拼多多
request if ${url} ~= /^http:\/\/101\.35\.204\.35\/d/i then reject(503)
request if ${url} ~= /^http:\/\/101\.35\.212\.35\/d/i then reject(503)
request if ${url} ~= /^http:\/\/114\.110\.96\.26\/d/i then reject(503)
request if ${url} ~= /^http:\/\/114\.110\.97\.97\/d/i then reject(503)
request if ${url} ~= /^http:\/\/\[240c:409f::3:0:163\]\/d/i then reject(503)
request if ${url} ~= /^http:\/\/\[240c:409f::3:0:359\]\/d/i then reject(503)
request if ${url} ~= /^http:\/\/\[2402:4e00:1411:201:0:9964:ba21:5a41\]\/d/i then reject(503)

# 腾讯
request if ${url} ~= /^http:\/\/182\.254\.116\.117\/d/i then reject(503)
request if ${url} ~= /^http:\/\/182\.254\.118\.119\/d/i then reject(503)
request if ${url} ~= /^http:\/\/103\.41\.167\.237\/v2\/resolv/i then reject(503)

# 微信
request if ${url} ~= /^https?:\/\/dns\.weixin\.qq\.com\/cgi-bin\/micromsg-bin\/newgetdns/i then reject(503)
request if ${url} ~= /^https?:\/\/dns\.weixin\.qq\.com\.cn\/cgi-bin\/micromsg-bin\/newgetdns/i then reject(503)
request if ${url} ~= /^https?:\/\/short\.weixin\.qq\.com\/cgi-bin\/micromsg-bin\/getcdndns/i then reject(503)
request if ${url} ~= /^https?:\/\/hkextshort\.weixin\.qq\.com\/cgi-bin\/micromsg-bin\/getcdndns/i then reject(503)

# HTTPS 端点（需 MITM）
request if ${url} ~= /^https:\/\/appconf\.mail\.163\.com\/mailmaster\/api\/http\/urlConfig\.do$/i then reject(503)
request if ${url} ~= /^https:\/\/cdn\.wup\.huya\.com\/monitor\/monitor\.jsp/i then reject(503)
request if ${url} ~= /^https:\/\/msglb\.91160\.com\/msg\/outer\/broker\/get$/i then reject(503)
request if ${url} ~= /^https:\/\/gslbali\.ximalaya\.com\/linkeye-cloud\/httpdns\//i then reject(503)
request if ${url} ~= /^https:\/\/ucdc\d?-upaas\.uc\.cn\/api\/v\d\/dns_query\?/i then reject(503)
request if ${url} ~= /^https:\/\/gw-cn\.jiaoliuqu\.com\/taqu-im-broadcast-srv\/v\d\/Comet\/get\?/i then reject(503)

[MITM]
hostname = appconf.mail.163.com, msglb.91160.com, ucdc-upaas.uc.cn, ucdc2-upaas.uc.cn, gw-cn.jiaoliuqu.com, gslbali.ximalaya.com, cdn.wup.huya.com   
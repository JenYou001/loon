#!name=X App Adblock - Module Remove
#!desc=移除 X/Twitter 首页和详情页的广告模块，参考公开脚本思路，保留正常内容（MITM required）
#!author=GitHub Copilot
#!homepage=https://github.com/JenYou001/loon

[Rule]
DOMAIN-SUFFIX,ads-twitter.com,REJECT
DOMAIN-SUFFIX,p.twitter.com,REJECT
DOMAIN-SUFFIX,scribe.twitter.com,REJECT
DOMAIN-SUFFIX,syndication.twitter.com,REJECT
DOMAIN-SUFFIX,syndication-o.twitter.com,REJECT
DOMAIN-SUFFIX,urls.api.twitter.com,REJECT
DOMAIN,ads.twitter.com,REJECT
DOMAIN,ads-api.twitter.com,REJECT
DOMAIN,ads.twimg.com,REJECT
DOMAIN,analytics.twitter.com,REJECT
DOMAIN,ads.doubleclick.net,REJECT
DOMAIN,pagead2.googlesyndication.com,REJECT
DOMAIN,gads.google.com,REJECT

[Script]
http-response ^https?:\/\/(api\.|mobile\.)?(twitter|x)\.com\/(1\.1\/|2\/).* requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/JenYou001/loon/main/x-twitter-adblock.js, timeout=60

[MITM]
hostname = api.twitter.com,api.x.com,mobile.twitter.com,twitter.com,x.com

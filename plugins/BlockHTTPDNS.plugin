[MITM]
hostname = appconf.mail.163.com, msglb.91160.com, ucdc-upaas.uc.cn, ucdc2-upaas.uc.cn, gw-cn.jiaoliuqu.com, gslbali.ximalaya.com, cdn.wup.huya.com, amdcopen.m.taobao.com, umengacs.m.taobao.com, amdcopen.m.umeng.com


#!name = DoH/HTTPDNS 全拦截（AdGuard DoH 专用）Final
#!desc = 拦截所有 App 内置 HTTPDNS/DoH/DoT/DoQ/AMDC 端点，强制全部 DNS 走系统 AdGuard DoH
#!author = VirgilClyne, 可莉, JenYou001
#!loon_version = 3.5.3(1007)
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/Other_icon/120px/HTTPDNS.png
#!tag = 安全,DoH,HTTPDNS,AdGuard
#!type = normal

[Rule]
# ═══════════════════════════════════════════════════════
# 第一层：关键词通配（兜底）
# ═══════════════════════════════════════════════════════
DOMAIN-KEYWORD,httpdns,REJECT
DOMAIN-KEYWORD,httpsdns,REJECT
DOMAIN-KEYWORD,http-dns,REJECT
DOMAIN-KEYWORD,https-dns,REJECT
DOMAIN-KEYWORD,amdc,REJECT
DOMAIN-KEYWORD,hdns,REJECT
DOMAIN-KEYWORD,apdns,REJECT
DOMAIN-KEYWORD,apipdns,REJECT
DOMAIN-KEYWORD,doq-,REJECT
DOMAIN-KEYWORD,dot-dns,REJECT

# ═══════════════════════════════════════════════════════
# 第二层：USER-AGENT（SDK 自标识）
# ═══════════════════════════════════════════════════════
USER-AGENT,httpdns*,REJECT
USER-AGENT,httpsdns*,REJECT
USER-AGENT,Httpdns*,REJECT
USER-AGENT,HttpDns*,REJECT
USER-AGENT,http-dns*,REJECT
USER-AGENT,AMDC*,REJECT
USER-AGENT,amdc*,REJECT

# ═══════════════════════════════════════════════════════
# 第三层：公共 DoH/DoT/DoQ 端点
# ═══════════════════════════════════════════════════════

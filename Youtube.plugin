#!name=YouTube去广告隐藏Shorts
#!desc=适用于 YouTube 去广告
#!author=@maasea @ZenmoFeiShi
#!homepage=https://github.com/Maasea/sgmodule
#!homepage=https://github.com/ZenmoFeiShi/Qx/blob/main/youtube.response.js

[Rewrite]
# 该规则原捕获组与替换逻辑可能不稳定，先停用，避免误重定向或视频请求异常。
^https?:\/\/([\w-]+\.googlevideo\.com\/(?!dclk_video_ads).+?&ctier=L)(&.+?),ctier,(.+)$ 302 https://$1$2$3

^https?:\/\/[^\s]*\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback\?)).+&oad reject-200
^https?:\/\/(www|s)\.youtube\.com\/api\/stats\/ads reject-200
^https?:\/\/(www|s)\.youtube\.com\/(pagead|ptracking) reject-200
^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?adcontext reject-200

[Script]
# YouTube.js 文件名已与仓库内实际文件一致，且脚本需要处理响应体，所以启用 requires-body=true。
http-response ^https?:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch) script-path=Youtube.js, requires-body=true

[MITM]
hostname = *.googlevideo.com, redirector*.googlevideo.com, www.youtube.com, s.youtube.com, youtubei.googleapis.com
